# SOLO para el entorno local contenido en Docker. Copiar a .env y generar secretos.
APP_NAME="KODIGO Store"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://127.0.0.1:8093
APP_KEY=
JWT_SECRET=

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=kodigo_docker_store
DB_USERNAME=kodigo_store
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Checkout de prueba OPCIONAL; no incluir credenciales en Git.
FRONTEND_URL=http://localhost:3001
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd

LOG_CHANNEL=stderr
CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
